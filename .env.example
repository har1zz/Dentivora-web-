# ---- Supabase (create a new project, then copy these from Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used for booking + chat tools.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Email (Gmail SMTP) ----
# Create an App Password at Google Account > Security > 2-Step Verification > App passwords
GMAIL_USER=harizzz191@gmail.com
GMAIL_APP_PASSWORD=
# Where new-booking alerts go (defaults to GMAIL_USER)
CLINIC_NOTIFY_EMAIL=harizzz191@gmail.com

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Long random string used to sign cancel/reschedule links
BOOKING_LINK_SECRET=

# ---- MyChatBot website widget (from the MyChatBot dashboard) ----
# Public identifiers from the widget embed snippet (not secrets)
NEXT_PUBLIC_MYCHATBOT_ACCOUNT_ID=b7ec45dd-3448-4b8e-b767-d49bbc223923
NEXT_PUBLIC_MYCHATBOT_WIDGET_ID=dentivora-site
